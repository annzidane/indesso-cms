{
  "kind": "collectionType",
  "collectionName": "applicants",
  "info": {
    "singularName": "applicant",
    "pluralName": "applicants",
    "displayName": "C - Applicant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 50
    },
    "phone_number": {
      "type": "string",
      "minLength": 10,
      "maxLength": 15,
      "required": true
    },
    "address": {
      "type": "text",
      "maxLength": 250,
      "required": true
    },
    "position": {
      "type": "string",
      "required": true
    },
    "cv": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
