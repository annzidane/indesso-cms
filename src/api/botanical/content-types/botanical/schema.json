{
  "kind": "collectionType",
  "collectionName": "botanicals",
  "info": {
    "singularName": "botanical",
    "pluralName": "botanicals",
    "displayName": "OB - Botanical"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "scientific_name": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "blocks"
    },
    "image_1": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "image_2": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "botanical"
    }
  }
}
