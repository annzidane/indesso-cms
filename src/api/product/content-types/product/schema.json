{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "product_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-type.product-type"
    },
    "botanical": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::botanical.botanical",
      "inversedBy": "products"
    },
    "organoleptics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::organoleptic.organoleptic",
      "mappedBy": "product"
    },
    "product_format": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-format.product-format"
    },
    "industry_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry-category.industry-category",
      "mappedBy": "products"
    },
    "general_information": {
      "type": "component",
      "component": "our-business.general-information",
      "repeatable": false
    }
  }
}
